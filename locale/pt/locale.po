msgid "plugins.generic.recommendByAuthor.displayName"
msgstr "Artigos recomendados por Autor"

msgid "plugins.generic.recommendByAuthor.description"
msgstr "Este plugin insere uma lista de artigos do mesmo autor na página do resumo do artigo."

msgid "plugins.generic.recommendByAuthor.heading"
msgstr "Artigos mais lidos do(s) mesmo(s) autor(es)"

msgid "plugins.generic.recommendByAuthor.task.name"
msgstr "Atualizar recomendações por autor"

msgid "plugins.generic.recommendByAuthor.task.result"
msgstr "{$refreshed} submissão(ões) atualizada(s); {$queued} nova(s) na fila."

msgid "plugins.generic.recommendByAuthor.settings.description"
msgstr "As recomendações são calculadas em segundo plano e lidas de uma cache, de modo que a página do artigo nunca as calcula enquanto o leitor espera."

msgid "plugins.generic.recommendByAuthor.settings.status.title"
msgstr "Cobertura"

msgid "plugins.generic.recommendByAuthor.settings.status.body"
msgstr "{$computed} de {$total} submissões inscritas têm recomendações; {$pending} ainda em fila."

msgid "plugins.generic.recommendByAuthor.settings.display.title"
msgstr "Apresentação"

msgid "plugins.generic.recommendByAuthor.settings.recommendationCount"
msgstr "Recomendações por página"

msgid "plugins.generic.recommendByAuthor.settings.maxRecommendations"
msgstr "Máximo de recomendações armazenadas por artigo"

msgid "plugins.generic.recommendByAuthor.settings.orderBy"
msgstr "Ordenar recomendações por"

msgid "plugins.generic.recommendByAuthor.settings.orderBy.metric"
msgstr "Mais lidos (visualizações e downloads)"

msgid "plugins.generic.recommendByAuthor.settings.orderBy.date"
msgstr "Publicados mais recentemente"

msgid "plugins.generic.recommendByAuthor.settings.matchByOrcid"
msgstr "Também identificar autores pelo ORCID"

msgid "plugins.generic.recommendByAuthor.settings.matchByOrcid.hint"
msgstr "Os nomes são sempre comparados. O ORCID apenas acrescenta artigos que o nome sozinho não encontraria, como os de um autor que mudou de sobrenome."

msgid "plugins.generic.recommendByAuthor.settings.refresh.title"
msgstr "Atualização"

msgid "plugins.generic.recommendByAuthor.settings.refresh.hint"
msgstr "Cada execução da tarefa agendada atualiza uma fatia da revista, começando pelas menos recentes, de modo que as recomendações nunca expiram todas ao mesmo tempo."

msgid "plugins.generic.recommendByAuthor.settings.batchSize"
msgstr "Submissões atualizadas por execução"

msgid "plugins.generic.recommendByAuthor.settings.maxAgeDays"
msgstr "Atualizar recomendações com mais de (dias)"

msgid "plugins.generic.recommendByAuthor.settings.queueLimit"
msgstr "Inscrever no máximo esta quantidade de submissões (0 = sem limite)"

msgid "plugins.generic.recommendByAuthor.settings.rankingTtlHours"
msgstr "Reaproveitar os números de leitura por (horas)"

msgid "plugins.generic.recommendByAuthor.settings.htmlCacheHours"
msgstr "Manter a secção renderizada por (horas)"

msgid "plugins.generic.recommendByAuthor.settings.computeOnDemand"
msgstr "Calcular recomendações ausentes enquanto o leitor espera"

msgid "plugins.generic.recommendByAuthor.settings.computeOnDemand.hint"
msgstr "Desligado por omissão. Enquanto estiver desligado, um artigo cujas recomendações ainda não foram calculadas simplesmente não apresenta a secção, e a tarefa agendada preenche-a. Só vale a pena ligar em revistas pequenas."

msgid "plugins.generic.recommendByAuthor.settings.numberRequired"
msgstr "Informe um número inteiro."

msgid "plugins.generic.recommendByAuthor.task.indexing"
msgstr "{$indexed} submissão(ões) indexada(s); faltam {$remaining} para indexar antes de calcular as recomendações."
