msgid "plugins.generic.recommendByAuthor.displayName"
msgstr "\"Автор ұсынған мақалалар\" модулі"

msgid "plugins.generic.recommendByAuthor.description"
msgstr ""
"Автор мақалаларының тізімін мақаланың аңдатпа орналасқан бетіне "
"орналастырады."

msgid "plugins.generic.recommendByAuthor.heading"
msgstr "Осы автордың (немесе авторлардың) ең көп оқылатын мақалалары"

msgid "plugins.generic.recommendByAuthor.task.name"
msgstr "Refresh author recommendations"

msgid "plugins.generic.recommendByAuthor.task.result"
msgstr "Refreshed {$refreshed} submission(s); {$queued} new one(s) queued."

msgid "plugins.generic.recommendByAuthor.settings.description"
msgstr "Recommendations are computed in the background and read from a cache, so that the article page never computes them while a reader waits."

msgid "plugins.generic.recommendByAuthor.settings.status.title"
msgstr "Coverage"

msgid "plugins.generic.recommendByAuthor.settings.status.body"
msgstr "{$computed} of {$total} enrolled submissions have recommendations; {$pending} still queued."

msgid "plugins.generic.recommendByAuthor.settings.display.title"
msgstr "Display"

msgid "plugins.generic.recommendByAuthor.settings.recommendationCount"
msgstr "Recommendations per page"

msgid "plugins.generic.recommendByAuthor.settings.maxRecommendations"
msgstr "Maximum recommendations stored per article"

msgid "plugins.generic.recommendByAuthor.settings.orderBy"
msgstr "Order recommendations by"

msgid "plugins.generic.recommendByAuthor.settings.orderBy.metric"
msgstr "Most read (views and downloads)"

msgid "plugins.generic.recommendByAuthor.settings.orderBy.date"
msgstr "Most recently published"

msgid "plugins.generic.recommendByAuthor.settings.matchByOrcid"
msgstr "Also match authors by ORCID"

msgid "plugins.generic.recommendByAuthor.settings.matchByOrcid.hint"
msgstr "Names are always matched. ORCID matching only adds articles that the name alone would miss, such as those of an author who has since changed their surname."

msgid "plugins.generic.recommendByAuthor.settings.refresh.title"
msgstr "Refresh"

msgid "plugins.generic.recommendByAuthor.settings.refresh.hint"
msgstr "Each run of the scheduled task refreshes a slice of the journal, the least recently computed first, so that recommendations never all expire at the same moment."

msgid "plugins.generic.recommendByAuthor.settings.batchSize"
msgstr "Submissions refreshed per run"

msgid "plugins.generic.recommendByAuthor.settings.maxAgeDays"
msgstr "Refresh recommendations older than (days)"

msgid "plugins.generic.recommendByAuthor.settings.queueLimit"
msgstr "Enrol at most this many submissions (0 = no limit)"

msgid "plugins.generic.recommendByAuthor.settings.rankingTtlHours"
msgstr "Reuse the reading figures for (hours)"

msgid "plugins.generic.recommendByAuthor.settings.htmlCacheHours"
msgstr "Keep the rendered section for (hours)"

msgid "plugins.generic.recommendByAuthor.settings.computeOnDemand"
msgstr "Compute missing recommendations while the reader waits"

msgid "plugins.generic.recommendByAuthor.settings.computeOnDemand.hint"
msgstr "Off by default. While off, an article whose recommendations have not been computed yet simply shows no section, and the scheduled task fills it in. Turning it on is only advisable on small journals."

msgid "plugins.generic.recommendByAuthor.settings.numberRequired"
msgstr "Please enter a whole number."

msgid "plugins.generic.recommendByAuthor.task.indexing"
msgstr "Indexed {$indexed} submission(s); {$remaining} still to index before recommendations can be computed."
