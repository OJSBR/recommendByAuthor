msgid "plugins.generic.recommendByAuthor.displayName"
msgstr "Artikel anhand Autor/in empfehlen"

msgid "plugins.generic.recommendByAuthor.description"
msgstr ""
"Dieses Plugin ergänzt eine Liste von Artikeln des/der gleichen Autor/in auf "
"der Artikel-Abstractseite."

msgid "plugins.generic.recommendByAuthor.heading"
msgstr "Am häufigsten gelesenen Artikel dieser/dieses Autor/in"

msgid "plugins.generic.recommendByAuthor.task.name"
msgstr "Autor/innen-Empfehlungen aktualisieren"

msgid "plugins.generic.recommendByAuthor.task.result"
msgstr "{$refreshed} Einreichung(en) aktualisiert; {$queued} neue in der Warteschlange."

msgid "plugins.generic.recommendByAuthor.settings.description"
msgstr "Die Empfehlungen werden im Hintergrund berechnet und aus einem Cache gelesen, damit die Artikelseite sie nie berechnet, während ein/e Leser/in wartet."

msgid "plugins.generic.recommendByAuthor.settings.status.title"
msgstr "Abdeckung"

msgid "plugins.generic.recommendByAuthor.settings.status.body"
msgstr "{$computed} von {$total} erfassten Einreichungen haben Empfehlungen; {$pending} stehen noch in der Warteschlange."

msgid "plugins.generic.recommendByAuthor.settings.display.title"
msgstr "Anzeige"

msgid "plugins.generic.recommendByAuthor.settings.recommendationCount"
msgstr "Empfehlungen pro Seite"

msgid "plugins.generic.recommendByAuthor.settings.maxRecommendations"
msgstr "Maximal gespeicherte Empfehlungen pro Artikel"

msgid "plugins.generic.recommendByAuthor.settings.orderBy"
msgstr "Empfehlungen sortieren nach"

msgid "plugins.generic.recommendByAuthor.settings.orderBy.metric"
msgstr "Meistgelesen (Aufrufe und Downloads)"

msgid "plugins.generic.recommendByAuthor.settings.orderBy.date"
msgstr "Zuletzt veröffentlicht"

msgid "plugins.generic.recommendByAuthor.settings.matchByOrcid"
msgstr "Autor/innen auch über ORCID zuordnen"

msgid "plugins.generic.recommendByAuthor.settings.matchByOrcid.hint"
msgstr "Namen werden immer verglichen. ORCID ergänzt nur Artikel, die der Name allein nicht finden würde, etwa von Autor/innen, die seither ihren Nachnamen geändert haben."

msgid "plugins.generic.recommendByAuthor.settings.refresh.title"
msgstr "Aktualisierung"

msgid "plugins.generic.recommendByAuthor.settings.refresh.hint"
msgstr "Jeder Lauf der geplanten Aufgabe aktualisiert einen Teil der Zeitschrift, die am längsten nicht berechneten zuerst, sodass die Empfehlungen nie alle gleichzeitig ablaufen."

msgid "plugins.generic.recommendByAuthor.settings.batchSize"
msgstr "Einreichungen pro Lauf"

msgid "plugins.generic.recommendByAuthor.settings.maxAgeDays"
msgstr "Empfehlungen aktualisieren, die älter sind als (Tage)"

msgid "plugins.generic.recommendByAuthor.settings.queueLimit"
msgstr "Höchstens so viele Einreichungen erfassen (0 = unbegrenzt)"

msgid "plugins.generic.recommendByAuthor.settings.rankingTtlHours"
msgstr "Lesezahlen wiederverwenden für (Stunden)"

msgid "plugins.generic.recommendByAuthor.settings.htmlCacheHours"
msgstr "Den erzeugten Abschnitt aufbewahren für (Stunden)"

msgid "plugins.generic.recommendByAuthor.settings.computeOnDemand"
msgstr "Fehlende Empfehlungen berechnen, während der/die Leser/in wartet"

msgid "plugins.generic.recommendByAuthor.settings.computeOnDemand.hint"
msgstr "Standardmäßig aus. Solange die Option aus ist, zeigt ein Artikel, dessen Empfehlungen noch nicht berechnet wurden, den Abschnitt einfach nicht an, und die geplante Aufgabe füllt ihn nach. Das Einschalten empfiehlt sich nur bei kleinen Zeitschriften."

msgid "plugins.generic.recommendByAuthor.settings.numberRequired"
msgstr "Bitte eine ganze Zahl eingeben."

msgid "plugins.generic.recommendByAuthor.task.indexing"
msgstr "{$indexed} Einreichung(en) indexiert; {$remaining} müssen noch indexiert werden, bevor Empfehlungen berechnet werden können."

msgid "plugins.generic.recommendByAuthor.previous"
msgstr "Zurück"

msgid "plugins.generic.recommendByAuthor.next"
msgstr "Weiter"

msgid "plugins.generic.recommendByAuthor.showing"
msgstr "Zeige {$start}-{$end} von {$total}"
