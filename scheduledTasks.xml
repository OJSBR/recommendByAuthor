<!DOCTYPE scheduled_tasks SYSTEM "../../../lib/pkp/dtd/scheduledTasks.dtd">

<scheduled_tasks>
	<task class="plugins.generic.recommendByAuthor.classes.tasks.RefreshAuthorRecommendations">
		<descr>Refresh a slice of the stored "articles by the same author" recommendations.</descr>
		<frequency minute="*/15"/>
	</task>
</scheduled_tasks>
